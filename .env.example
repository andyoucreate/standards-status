# Standards tenant the page reads from and the cron writes to
STANDARDS_API_URL=https://api.standards.new
# API key whose role grants architect:update (needed once by `pnpm schema:sync`) and records read/write
STANDARDS_API_KEY=
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
# Injected by Vercel when a Blob store is linked. Optional: without it the page has no offline fallback.
BLOB_READ_WRITE_TOKEN=
